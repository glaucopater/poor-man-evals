{
  "name": "poor-man-evals",
  "version": "0.1.0",
  "description": "A minimal LLM eval harness: runs a prompt dataset against a list of Groq-hosted models, scores outputs with an LLM-as-judge, and logs everything to Langfuse.",
  "type": "module",
  "main": "src/runEval.js",
  "scripts": {
    "eval": "node src/runEval.js",
    "eval:text": "node src/runEval.js text",
    "eval:image": "node src/runEval.js image",
    "verify:langfuse": "node scripts/verify-langfuse-v5.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
