# --- Groq (model provider under test) ---
GROQ_API_KEY=

# --- NVIDIA NIM (model provider under test) ---
# Required only if src/models.js has entries tagged provider: "nvidia".
# Get a key at https://build.nvidia.com (it starts with "nvapi-").
NVIDIA_API_KEY=

# Optional: which providers to actually run, comma-separated.
# Defaults to all known providers. Add "nvidia" back here once its endpoint and
# your key work -- until then the startup probe will fail on every NVIDIA model.
# See the Troubleshooting section in README.md for the 403 "Authorization failed" case.
# Set to "ollama" for a fully local, zero-cost run (also set JUDGE_PROVIDER/JUDGE_MODEL
# below, or the judge still calls Groq and the run still needs a Groq key).
ENABLED_PROVIDERS=groq

# --- Ollama (local model runtime) ---
# No API key: a local server has nothing to authenticate. Must be running
# (`ollama serve`) with the models in src/models.js pulled (`ollama list`).
# The harness talks to Ollama's NATIVE /api/chat API, not its OpenAI-compat shim,
# so structured output (a full JSON Schema via `format`), `think`, and
# `repeat_penalty` are all available -- none of which the hosted APIs expose.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: local runs need no throttle by default. These exist mainly to bound
# retries, since a cold model load can drop a connection.
OLLAMA_MIN_REQUEST_INTERVAL_MS=0
OLLAMA_MAX_RETRIES=2

# IMPORTANT for image evals: num_predict from the prompt plus the tokens the
# image costs must fit this window, or Ollama silently truncates the response
# mid-JSON. A 1920x1080 image costs roughly 2.3k prompt tokens.
# OLLAMA_CONTEXT_LENGTH=8192

# --- Langfuse (tracing + eval scores) ---
# Get these from your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud regions: https://cloud.langfuse.com (US), https://cloud.langfuse.com (EU default),
# https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com, https://hipaa.cloud.langfuse.com
# Use your self-hosted URL if applicable. Must be a Langfuse v4 server.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: environment tag for this run. In Langfuse v5 this replaces the
# `environment` trace attribute and is read by BOTH the span processor and the
# client that writes scores, so traces and scores stay in one environment.
# Defaults to NODE_ENV (see src/instrumentation.js), i.e. "development" locally.
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional: release tag (replaces the removed `release` trace attribute).
# LANGFUSE_RELEASE=

# Optional: model used as the LLM-as-judge.
# Can be any chat model id available on JUDGE_PROVIDER. For a fully local run
# use JUDGE_PROVIDER=ollama with a local id, e.g. qwen3.8:27b or gemma4:12b.
JUDGE_MODEL=openai/gpt-oss-20b

# Optional: which provider runs the judge -- "groq" (default), "nvidia" or "ollama".
# The judge runs on Groq even when the models under test are on NVIDIA, so the
# scorer stays independent from the models being scored.
JUDGE_PROVIDER=groq

# Optional: output budget for ONE verdict. A verdict is ~40-150 tokens, so the
# default is generous headroom. Raise it only if you enable JUDGE_THINK.
JUDGE_MAX_COMPLETION_TOKENS=512

# Optional: let the judge reason before answering. Defaults to false, and is only
# sent to providers that support the switch (Ollama). A judge needs a terse
# verdict, not visible reasoning -- on local Ollama, thinking ON made gemma4:12b
# burn 1000 tokens and still return nothing parseable, while thinking OFF
# returned a verdict in 39. Set true only if your judge genuinely reasons better
# out loud, and then raise JUDGE_MAX_COMPLETION_TOKENS to match.
# JUDGE_THINK=false

# Optional: rate-limit handling for Groq's free tier (some models allow as
# few as 10-30 requests/minute). The client waits at least this long between
# requests and retries on 429 with backoff. Raise the interval if you're
# still getting rate limited; lower it if you're on a paid tier.
GROQ_MIN_REQUEST_INTERVAL_MS=2200
GROQ_MAX_RETRIES=5

# Optional: same knobs for NVIDIA NIM (limits vary by plan and model).
NVIDIA_MIN_REQUEST_INTERVAL_MS=2200
NVIDIA_MAX_RETRIES=5

NODE_ENV=development
