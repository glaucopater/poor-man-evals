# poor-man-evals secrets.
#
# Everything else lives in eval.config.yaml, which is structured, validated, and
# safe to commit (copy eval.config.example.yaml to get started). This file holds
# only credentials, so it stays short enough to read at a glance.
#
# Any variable set in your real shell still wins over both files, so one-off
# runs work unchanged:
#   ENABLED_PROVIDERS=ollama yarn eval:complex

# --- Langfuse (tracing + eval scores) ---
# Project settings -> API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Groq ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- NVIDIA NIM ---
# https://build.nvidia.com (starts with "nvapi-"). Only needed if
# src/models.js has entries tagged provider: "nvidia".
NVIDIA_API_KEY=

# --- Overrides (usually set in eval.config.yaml instead) ---
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# EVAL_PROFILE=local