# --- Groq (model provider under test) ---
GROQ_API_KEY=

# --- Langfuse (tracing + eval scores) ---
# Get these from your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud regions: https://cloud.langfuse.com (US), https://cloud.langfuse.com (EU default),
# https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com, https://hipaa.cloud.langfuse.com
# Use your self-hosted URL if applicable.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: model used as the LLM-as-judge (defaults to openai/gpt-oss-20b).
# Can be any chat-capable model id available on your Groq account.
JUDGE_MODEL=openai/gpt-oss-20b

# Optional: rate-limit handling for Groq's free tier (some models allow as
# few as 10-30 requests/minute). The client waits at least this long between
# requests and retries on 429 with backoff. Raise the interval if you're
# still getting rate limited; lower it if you're on a paid tier.
GROQ_MIN_REQUEST_INTERVAL_MS=2200
GROQ_MAX_RETRIES=5

NODE_ENV=development
